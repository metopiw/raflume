{
  "name": "raflume-desktop-organizer",
  "version": "1.6.3",
  "private": true,
  "description": "Raflume — safe Windows Desktop and Downloads file organizer",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && node scripts/bundle-preload.mjs && node scripts/write-electron-package.mjs",
    "build:renderer": "node node_modules/vite/bin/vite.js build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "start": "npm run build && electron .",
    "start:built": "electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "chokidar": "^3.6.0",
    "electron-store": "^8.1.0",
    "electron-log": "^5.1.0",
    "fs-extra": "^11.2.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "class-variance-authority": "^0.7.0",
    "lucide-react": "^0.400.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.14.0",
    "@types/fs-extra": "^11.0.4",
    "esbuild": "^0.21.5"
  },
  "productName": "Raflume",
  "author": "mertpivvo",
  "license": "MIT",
  "build": {
    "appId": "com.mertpivvo.raflume",
    "productName": "Raflume",
    "win": {
      "icon": "assets/app-icon.ico"
    }
  }
}
